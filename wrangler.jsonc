{
  // Silent Earth — Cloudflare Worker serving static assets only.
  // No server code: the game is a Vite SPA built into ./dist.
  //
  // WIP NO-BUILD RULE: WIP pushes do not build; only merges to
  // main build (production branch = main, preview builds OFF on
  // the dashboard). This file must reach main BEFORE the repo is
  // connected in the Cloudflare dashboard.
  //
  // Dashboard Builds settings (Adam's dashboard side, not this
  // file): build `npm run build`, deploy `npx wrangler deploy`.
  // No build/deploy commands live in this file, and no .npmrc
  // ships with it — npm install runs clean, so no peer-deps
  // fix is evidenced.
  "name": "silentearth",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist"
  }
}
